{
    acme_dns cloudflare {env.CLOUDFLARE_API_TOKEN}
}

# Container-local serving check; this port is not published.
http://127.0.0.1:8081 {
    bind 127.0.0.1
    respond /health "OK" 200
}

(cert) {
    encode zstd gzip

    log {
        output file {$CADDY_LOG_DIR:/data/logs}/access.log {
            roll_size 100mb
            roll_keep 5
            roll_keep_for 720h
        }
        format json
    }
}


