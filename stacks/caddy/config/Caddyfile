dns.lesicnik.eu {
    import cert
    @dnsquery path /dns-query*
    handle @dnsquery {
        reverse_proxy https://192.168.10.9:3443 {
            header_up Host {upstream_hostport}
            transport http {
                tls_insecure_skip_verify
            }
        }
    }
    handle {
        respond 404
    }
}

